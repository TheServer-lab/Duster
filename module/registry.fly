$ ============================================================================
$ Duster Registry Module -- parses reg.sleep and resolves app versions
$ ============================================================================
$
$ In online mode (DUSTER_RELEASE_BASE non-empty) the manifest is fetched over
$ HTTPS from the Duster repository (DUSTER_REGISTRY_URL, defaulting to the
$ project's reg.sleep). In offline mode (DUSTER_RELEASE_BASE set to an empty
$ string) the local regPath is read instead.

bring filesystem
bring environment
bring download
bring sleep

native job rt_char_from_code(code)
native job rt_throwv(v)

job duster_parse_registry(regContent) {
  parsed = sleep.parse_text(regContent)
  registry = {}
  pkgEntry = parsed["package"]
  pkgs = []
  t = rt_typename(pkgEntry)
  if t == "coll" {
    pkgs = pkgEntry
  } ifnot {
    if t == "board" {
      attach(pkgs, pkgEntry)
    }
  }
  for pkg in pkgs {
    if rt_typename(pkg) == "board" {
      name = pkg["name"]
      license = pkg["license"]
      version = pkg["version"]
      installer_type = pkg["installer_type"]
      verification_hash = pkg["verification_hash"]
      category = pkg["category"]
      file_name = pkg["file_name"]
      file_hash = pkg["file_hash"]
      sha256_field = pkg["sha256"]
      if file_name == EMP {
        file_name = pkg["artifact"]
      }
      if name != EMP {
        normName = lower(name)
        place(registry, normName, {
          "name": name,
          "license": license,
          "version": version,
          "installer_type": installer_type,
          "verification_hash": verification_hash,
          "category": category,
          "file_name": file_name,
          "file_hash": file_hash,
          "sha256": sha256_field
        })
      }
    }
  }
  give registry
}

job duster_load_registry(path) {
  baseUrl = environment.get("DUSTER_RELEASE_BASE")
  if baseUrl == EMP {
    baseUrl = "https://raw.githubusercontent.com/TheServer-lab/Duster/refs/heads/main/RELEASE"
  }
  if count(baseUrl) == 0 {
    do {
      content = filesystem.read(path)
      give duster_parse_registry(content)
    } grab (err) {
      rt_throwv("duster: failed to read registry {path}: {err}")
    }
  }
  regUrl = environment.get("DUSTER_REGISTRY_URL")
  if regUrl == EMP {
    regUrl = "https://raw.githubusercontent.com/TheServer-lab/Duster/refs/heads/main/reg.sleep"
  }
  text = download.duster_fetch_text(regUrl)
  give duster_parse_registry(text)
}
