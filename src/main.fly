$ ============================================================================
$ Duster Main CLI -- entry point for duster commands
$ ============================================================================

bring download
bring filesystem
bring path
bring zip
bring registry
bring installer

job main() {
  args = process.args()
  if count(args) < 1 {
    show("usage: duster [list|search|install|upgrade|uninstall] <app>")
    process.exit(1)
  }

  cmd = args[0]
  if cmd == "-install" or cmd == "install" {
    if count(args) < 2 {
      show("error: missing application name")
      process.exit(1)
    }
    interactiveMode = No
    reqArg = EMP
    for arg in args {
      if arg == "-interact" or arg == "--interactive" or arg == "-interactive" {
        interactiveMode = Yes
      } ifnot {
        if arg != cmd {
          if reqArg == EMP {
            reqArg = arg
          }
        }
      }
    }

    if reqArg == EMP {
      show("error: missing application name or requirements file")
      process.exit(1)
    }

    isReqFile = No
    if filesystem.exists(reqArg) {
      isReqFile = Yes
    } ifnot {
      if has(lower(reqArg), ".dusterinstall") {
        isReqFile = Yes
      }
    }

    do {
      if isReqFile == Yes {
        resolved = installer.duster_resolve_paths(reqArg)
        installer.duster_install_requirements(resolved["reqPath"], resolved["regPath"], resolved["releasesDir"], resolved["workDir"], interactiveMode)
      } ifnot {
        appName = reqArg
        keep = No

        if count(args) >= 3 {
          if args[2] == "-keep" {
            keep = Yes
          }
        }

        if count(reqArg) >= 5 {
          suffix = reqArg[count(reqArg) - 5 : count(reqArg)]
          if suffix == "-keep" {
            appName = reqArg[0 : count(reqArg) - 5]
            keep = Yes
          }
        }

        paths = installer.duster_find_reg_and_releases()
        installer.duster_install_app_ex(appName, keep, paths["regPath"], paths["releasesDir"], paths["workDir"], Yes)
      }
    } grab (err) {
      show("error: {tex(err)}")
      process.exit(1)
    }
  } ifnot {
    if cmd == "list" {
      do {
        installer.duster_list_apps()
      } grab (err) {
        show("error: {err}")
        process.exit(1)
      }
    } ifnot {
      if cmd == "search" {
        if count(args) < 2 {
          show("error: missing search query")
          process.exit(1)
        }
        query = args[1]
        paths = installer.duster_find_reg_and_releases()
        do {
          installer.duster_search_apps(query, paths["regPath"])
        } grab (err) {
          show("error: {tex(err)}")
          process.exit(1)
        }
      } ifnot {
        if cmd == "upgrade" {
          if count(args) < 2 {
            show("error: missing application name")
            process.exit(1)
          }
          appName = args[1]
          paths = installer.duster_find_reg_and_releases()
          do {
            installer.duster_upgrade_app(appName, paths["regPath"], paths["releasesDir"], paths["workDir"])
          } grab (err) {
            show("error: {tex(err)}")
            process.exit(1)
          }
        } ifnot {
          if cmd == "uninstall" {
            if count(args) < 2 {
              show("error: missing application name")
              process.exit(1)
            }
            appName = args[1]
            paths = installer.duster_find_reg_and_releases()
            do {
              installer.duster_uninstall_app(appName, paths["regPath"], paths["workDir"])
            } grab (err) {
              show("error: {tex(err)}")
              process.exit(1)
            }
          } ifnot {
            show("unknown command: {cmd}")
            show("usage: duster [list|search|install|upgrade|uninstall]")
            process.exit(1)
          }
        }
      }
    }
  }
}

main()
